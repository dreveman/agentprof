+const MIN_SPLIT_PANE_PX = 360;
 
 export class PageManagerImpl implements PageManager {
   private readonly registry = new Registry<PageHandler>((x) => x.route);
@@ -29,6 +32,8 @@ export class PageManagerImpl implements PageManager {
   // Track the current page for analytics - log when it changes
   private currentPage: string | undefined;
   private readonly analytics: Analytics;
+  private splitPercent = 50;
+  private splitContainerEl?: HTMLElement;
 
   constructor(analytics: Analytics) {
     this.analytics = analytics;
@@ -42,8 +47,18 @@ export class PageManagerImpl implements PageManager {
   }
 
   // Called by index.ts upon the main frame redraw callback.
-  renderPageForCurrentRoute(): m.Children {
+  // When `primaryPage` is provided (e.g. '/agentprof' or '/viewer' with the
+  // split-secondary-pages setting enabled), the primary page stays mounted in
+  // `.pf-page-split__primary` across viewport resizes so component state is
+  // preserved. When `splitOpenAllowed` is true (wide viewports), secondary
+  // routes open alongside it on the right; on narrow viewports, the active
+  // pane takes the full width instead.
+  renderPageForCurrentRoute(
+    primaryPage?: string,
+    splitOpenAllowed = true,
+  ): m.Children {
     const route = Router.parseFragment(location.hash);
+    const activePage = route.page || '/';
 
     // Log page changes to analytics
     if (this.currentPage !== route.page) {
@@ -51,8 +66,17 @@ export class PageManagerImpl implements PageManager {
       setTimeout(() => this.analytics.logEvent('User Actions', route.page), 0);
     }
 
-    this.previousPages.set(route.page, {
-      page: route.page,
+    const useSplitContainer =
+      primaryPage !== undefined &&
+      primaryPage !== '/' &&
+      this.registry.tryGet(primaryPage) !== undefined;
+
+    if (useSplitContainer && !this.previousPages.has(primaryPage)) {
+      this.previousPages.set(primaryPage, {page: primaryPage, subpage: ''});
+    }
+
+    this.previousPages.set(activePage, {
+      page: activePage,
       subpage: route.subpage,
     });
 
@@ -61,18 +85,95 @@ export class PageManagerImpl implements PageManager {
     // scrolling position is retained between page flips, which can be handy
     // when quickly switching between pages that have long scrolling content
     // such as the timeline page.
-    return Array.from(this.previousPages.entries())
-      .map(([key, {page, subpage}]) => {
+    const entries = Array.from(this.previousPages.entries()).map(
+      ([key, {page, subpage}]) => {
         const maybeRenderedPage = this.renderPageForRoute(page, subpage);
         // If either the route doesn't exist or requires a trace but the trace
         // is not loaded, fall back on the default route.
         const renderedPage =
           maybeRenderedPage ?? ensureExists(this.renderPageForRoute('/', ''));
-        return [key, renderedPage];
-      })
-      .map(([key, page]) => {
-        return m(Gate, {open: key === route.page}, page);
+        return [key, renderedPage] as const;
+      },
+    );
+
+    if (!useSplitContainer) {
+      return entries.map(([key, page]) => {
+        return m(Gate, {key, open: key === activePage}, page);
       });
+    }
+
+    const hasSecondaryActive =
+      activePage !== primaryPage &&
+      this.registry.tryGet(activePage) !== undefined;
+    const isSplitOpen = splitOpenAllowed && hasSecondaryActive;
+    const showPrimary = !hasSecondaryActive || splitOpenAllowed;
+
+    return m(
+      '.pf-page-split',
+      {
+        oncreate: (vnode: m.VnodeDOM) => {
+          this.splitContainerEl = vnode.dom as HTMLElement;
+        },
+        onupdate: (vnode: m.VnodeDOM) => {
+          this.splitContainerEl = vnode.dom as HTMLElement;
+        },
+      },
+      m(
+        '.pf-page-split__primary',
+        {
+          style: !showPrimary
+            ? {display: 'none'}
+            : isSplitOpen
+              ? {
+                  flex: `0 0 ${this.splitPercent}%`,
+                  minWidth: `${MIN_SPLIT_PANE_PX}px`,
+                  maxWidth: `calc(100% - ${MIN_SPLIT_PANE_PX}px)`,
+                }
+              : {
+                  flex: '1 1 100%',
+                },
+        },
+        entries
+          .filter(([key]) => key === primaryPage)
+          .map(([key, page]) => m(Gate, {key, open: showPrimary}, page)),
+      ),
+      isSplitOpen &&
+        m(ResizeHandle, {
+          direction: 'horizontal',
+          onResizeAbsolute: (pos: number) => {
+            const width =
+              this.splitContainerEl?.getBoundingClientRect().width ?? 0;
+            if (width <= 0) return;
+            const minPct = (MIN_SPLIT_PANE_PX / width) * 100;
+            const maxPct = 100 - minPct;
+            this.splitPercent = Math.max(
+              minPct,
+              Math.min(maxPct, (pos / width) * 100),
+            );
+            m.redraw();
+          },
+        }),
+      hasSecondaryActive &&
+        m(
+          '.pf-page-split__secondary',
+          {
+            style: isSplitOpen
+              ? {
+                  flex: `0 0 ${100 - this.splitPercent}%`,
+                  minWidth: `${MIN_SPLIT_PANE_PX}px`,
+                  maxWidth: `calc(100% - ${MIN_SPLIT_PANE_PX}px)`,
+                }
+              : {
+                  flex: '1 1 100%',
+                },
+          },
+          entries
+            .filter(([key]) => key !== primaryPage)
+            .map(([key, page]) =>
+              m(Gate, {key, open: key === activePage}, page),
+            ),
+        ),
+    );
   }
 
   // Will return undefined if either: (1) the route does not exist; (2) the
