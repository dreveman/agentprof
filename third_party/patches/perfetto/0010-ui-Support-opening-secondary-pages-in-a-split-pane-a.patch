+
+import m from 'mithril';
+import type {Analytics} from '../public/analytics';
+import {PageManagerImpl} from './page_manager';
+
+const mockAnalytics: Analytics = {
+  logEvent: () => {},
+  logError: () => {},
+  isEnabled: () => false,
+};
+
+let root: HTMLDivElement;
+
+beforeEach(() => {
+  root = document.createElement('div');
+  document.body.appendChild(root);
+  location.hash = '';
+});
+
+afterEach(() => {
+  m.render(root, []);
+  root.remove();
+  location.hash = '';
+});
+
+test('PageManagerImpl renders secondary page alongside primary page when primaryPage is specified', () => {
+  const pages = new PageManagerImpl(mockAnalytics);
+  pages.registerPage({
+    route: '/',
+    render: () => m('.home-page', 'Home'),
+  });
+  pages.registerPage({
+    route: '/overview',
+    render: (subpage) => m('.overview-page', `Overview:${subpage ?? ''}`),
+  });
+  pages.registerPage({
+    route: '/viewer',
+    render: () => m('.viewer-page', 'Timeline'),
+  });
+
+  location.hash = '#!/overview/summary';
+  m.render(root, pages.renderPageForCurrentRoute('/overview'));
+
+  expect(root.querySelector('.pf-page-split')).not.toBeNull();
+  expect(root.querySelector('.pf-page-split__primary')?.textContent).toBe(
+    'Overview:/summary',
+  );
+  expect(root.querySelector('.pf-page-split__secondary')).toBeNull();
+
+  // Navigate to secondary route /viewer; primary /overview/summary stays open on the left
+  location.hash = '#!/viewer';
+  m.render(root, pages.renderPageForCurrentRoute('/overview'));
+
+  expect(root.querySelector('.pf-page-split__primary')?.textContent).toBe(
+    'Overview:/summary',
+  );
+  expect(
+    root.querySelectorAll('.pf-page-split__primary [data-gate-open]'),
+  ).toHaveLength(1);
+  expect(
+    root.querySelector('.pf-page-split__secondary .viewer-page')?.textContent,
+  ).toBe('Timeline');
+
+  // Navigating to '#!/?local_cache_key=' (where Router.parseFragment returns
+  // page === '') opens the '/' Welcome page in the secondary pane alongside
+  // the primary page.
+  location.hash = '#!/?local_cache_key=';
+  m.render(root, pages.renderPageForCurrentRoute('/overview'));
+  expect(root.querySelector('.pf-page-split__primary')?.textContent).toBe(
+    'Overview:/summary',
+  );
+  expect(
+    root.querySelector('.pf-page-split__secondary .home-page')?.textContent,
+  ).toBe('Home');
+
+  // On narrow viewports (splitOpenAllowed = false), the primary container stays
+  // in the tree (preserving component state across resizes) while hiding
+  // behind the full-width secondary route.
+  location.hash = '#!/viewer';
+  m.render(root, pages.renderPageForCurrentRoute('/overview', false));
+  expect(
+    (root.querySelector('.pf-page-split__primary') as HTMLElement)?.style
+      .display,
+  ).toBe('none');
+  expect(
+    root.querySelector('.pf-page-split__secondary .viewer-page')?.textContent,
+  ).toBe('Timeline');
+
+  // Without primaryPage (setting disabled), only the active route is open
+  location.hash = '#!/viewer';
+  m.render(root, pages.renderPageForCurrentRoute(undefined));
+  expect(root.querySelector('.pf-page-split')).toBeNull();
+  const gates = [...root.children] as HTMLElement[];
+  const openGateTexts = gates
+    .filter((g) => g.style.display !== 'none')
+    .map((g) => g.textContent);
+  expect(openGateTexts).toEqual(['Timeline']);
+});
