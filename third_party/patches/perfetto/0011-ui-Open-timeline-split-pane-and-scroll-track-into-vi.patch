@@ -160,8 +160,8 @@ async function getDataset(
         ts: 'ts',
         dur: 'dur',
         depth: {
-          join: 'depth',
-          expr: 'depth.depth',
+          join: tableName,
+          expr: `${tableName}.depth`,
         },
         name: 'name',
         thread_dur: 'thread_dur',
@@ -173,7 +173,7 @@ async function getDataset(
       },
       src: 'slice',
       joins: {
-        depth: {
+        [tableName]: {
           from: `${tableName} USING (id)`,
           unique: true,
         },
diff --git a/ui/src/widgets/track_shell.ts b/ui/src/widgets/track_shell.ts
index 5466f63448..92ca7fab28 100644
--- a/ui/src/widgets/track_shell.ts
+++ b/ui/src/widgets/track_shell.ts
@@ -190,8 +190,8 @@ export class TrackShell implements m.ClassComponent<TrackShellAttrs> {
     }
   }
 
-  onupdate({dom}: m.VnodeDOM<TrackShellAttrs, this>) {
-    if (this.scrollIntoView) {
+  onupdate({dom, attrs}: m.VnodeDOM<TrackShellAttrs, this>) {
+    if (this.scrollIntoView || attrs.scrollToOnCreate) {
       dom.scrollIntoView({behavior: 'instant', block: 'nearest'});
       this.scrollIntoView = false;
     }
